# Colle ici le webhook du salon Discord. Ne partage jamais cette adresse.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REMPLACE_MOI

# Réglages définis ensemble
CHECK_INTERVAL_MINUTES=30
MIN_CPM=0.80
MIN_TOTAL_BUDGET=3000
MIN_REMAINING_BUDGET=3000
MAX_USED_PERCENT=35
PREFERRED_USED_PERCENT=25
MAX_FAST_DEADLINE_HOURS=3

# false = navigateur invisible, true = navigateur visible
SHOW_BROWSER=false
